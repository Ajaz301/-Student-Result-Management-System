{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "database.db",
      "serviceAccountKey.json",
      "server.js",
      "firebaseAdmin.js",
      "firebaseService.js",
      "seed-firebase.js"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
